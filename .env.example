# 화재위험 예측 — 환경 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 저장소에 커밋되지 않습니다.

# --- DB (MariaDB) ---
FIRE_DB_HOST=
FIRE_DB_PORT=13306
FIRE_DB_USER=
FIRE_DB_PASS=
FIRE_DB_NAME=

# --- 서비스 ---
BACKEND_PORT=9522
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=9502
PUBLIC_DOMAIN=
MODEL_VERSION=m0-lookup-20260901

# --- 외부 API ---
# 기상청 단기예보조회서비스 (data.go.kr) 인증키. 미설정 시 배치는 M0 기저율로 폴백한다.
KMA_API_KEY=
